{
    "name": "dakotajune/blueprint_policies",
    "description": "First-class authorization policies for Laravel Blueprint: describe who can do what in draft.yaml, get policies, controller checks and registration.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-tokenizer": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel-shift/blueprint": "^2.10"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dakotajune\\BlueprintPolicies\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dakotajune\\BlueprintPolicies\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dakotajune\\BlueprintPolicies\\BlueprintPoliciesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
